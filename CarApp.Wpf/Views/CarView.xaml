<!-- CarApp.Wpf/Views/CarView.xaml -->

<UserControl x:Class="CarApp.Wpf.Views.CarView"

xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"

xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"

 Height="500" Width="720">

    <Grid Margin="12">

        <Grid.RowDefinitions>

            <RowDefinition Height="Auto"/>

            <RowDefinition Height="Auto"/>

            <RowDefinition Height="Auto"/>

            <RowDefinition Height="*"/>

        </Grid.RowDefinitions>


        <!-- Inputfelter -->

        <WrapPanel Grid.Row="0" Margin="0,0,0,8">

            <StackPanel Width="160" Margin="4">

                <Label Content="Maerke"/>

                <TextBox Text="{Binding SelectedCar.Brand,

UpdateSourceTrigger=PropertyChanged}"/>

            </StackPanel>

            <StackPanel Width="160" Margin="4">

                <Label Content="Model"/>

                <TextBox Text="{Binding SelectedCar.Model,

UpdateSourceTrigger=PropertyChanged}"/>

            </StackPanel>

            <StackPanel Width="80" Margin="4">

                <Label Content="Aar"/>

                <TextBox Text="{Binding SelectedCar.Year,

UpdateSourceTrigger=PropertyChanged}"/>

            </StackPanel>

            <StackPanel Width="120" Margin="4">

                <Label Content="Nummerplade"/>

                <TextBox Text="{Binding SelectedCar.LicensePlate,

UpdateSourceTrigger=PropertyChanged}"/>

            </StackPanel>

        </WrapPanel>


        <!-- Knapper -->

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">

            <Button Content="Tilføj" Command="{Binding AddCarCommand}"

Width="90" Margin="4"/>

            <Button Content="Opdater" Command="{Binding UpdateCarCommand}"

Width="90" Margin="4"/>

            <Button Content="Slet" Command="{Binding DeleteCarCommand}"

Width="90" Margin="4"/>

        </StackPanel>


        <!-- Søgelinje -->

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,8">

            <Label Content="Søg nummerplade:"/>

            <TextBox Text="{Binding SearchPlate,

UpdateSourceTrigger=PropertyChanged}"

Width="140" Margin="4,0"/>

            <Button Content="Find" Command="{Binding FindCarCommand}" Width="70"

Margin="4,0"/>

        </StackPanel>


        <!-- Liste -->

        <ListView Grid.Row="3"

ItemsSource="{Binding Cars}"

SelectedItem="{Binding SelectedCar, Mode=TwoWay}">

            <ListView.View>

                <GridView>
                    <GridViewColumn Header="Mærke" DisplayMemberBinding="{Binding Brand}" Width="130"/>

                    <GridViewColumn Header="Model"

DisplayMemberBinding="{Binding Model}" Width="130"/>

                    <GridViewColumn Header="År"

DisplayMemberBinding="{Binding Year}" Width="65"/>

                    <GridViewColumn Header="Nummerplade"

DisplayMemberBinding="{Binding LicensePlate}" Width="130"/>

                </GridView>

            </ListView.View>

        </ListView>

    </Grid>

</UserControl>